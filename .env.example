# --- сервер ---
DB_PATH=data/lapky.db
ADMIN_TOKEN=change-me-please        # токен для зміни даних через API (скрипти, Swagger)
BOT_USERNAME=                       # напр. lapky_help_bot (без @) — кнопки «Беру», «Записатися», «Стежити» на карті
ADMIN_TELEGRAM_IDS=                 # Telegram ID адміністраторів через кому (модерують заявки в боті: /moderate)

# --- спільне для сервера й бота ---
BOT_API_TOKEN=                      # довгий випадковий секрет: бот діє від імені користувачів Telegram

# --- бот ---
BOT_TOKEN=                          # від @BotFather
API_URL=http://127.0.0.1:8000       # де живе сервер
WEB_URL=http://127.0.0.1:8000       # публічна адреса вебкарти (для кнопок потрібен НЕ localhost)
COORDINATOR_EMAIL=lapky.team@example.com
